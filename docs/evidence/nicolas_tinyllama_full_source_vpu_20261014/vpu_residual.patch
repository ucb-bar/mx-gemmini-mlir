@@ -186,0 +188,27 @@
+#ifdef LLAMA_VPU_RESIDUAL
+// Lift the residual ADD command sequence from Nicolas's llama_layer_e2e.c.
+static void residual_vpu(const uint16_t *a, const uint16_t *b, uint16_t *out) {
+  const int rows = LLAMA_D; // Eight BF16 token rows, 16 bytes per SPAD row.
+  gemmini_config_ld(DIM);
+  gemmini_config_st(DIM);
+  for (int c = 0; c < LLAMA_M / 16; c++) {
+    for (int s = 0; s < 2; s++) {
+      const int token = c * 16 + s * 8;
+      const uint32_t x = (uint32_t) (2 * s * BANK_ROWS);
+      const uint32_t y = (uint32_t) ((2 * s + 1) * BANK_ROWS);
+      for (int r = 0; r < rows; r += DIM) {
+        gemmini_extended_mvin((const uint8_t *) (a + token * LLAMA_D) + r * DIM,
+                              x + r, DIM, DIM);
+        gemmini_extended_mvin((const uint8_t *) (b + token * LLAMA_D) + r * DIM,
+                              y + r, DIM, DIM);
+      }
+      gemmini_vpu_binary(VPU_ADD, x, x, y, rows);
+      for (int r = 0; r < rows; r += DIM)
+        gemmini_extended_mvout((uint8_t *) (out + token * LLAMA_D) + r * DIM,
+                               x + r, DIM, DIM);
+    }
+  }
+  gemmini_fence();
+}
+#endif
