+    fn compiler_mvin(&self, rs1: u64, rs2: u64, smem: &mut [u8], gmem: &[u8]) {
+        let rows = ((rs2 >> 48) & 0xffff) as usize;
+        let cols = ((rs2 >> 32) & 0xffff) as usize;
+        let row = (rs2 & 0xffff_ffff) as usize;
+        assert!(cols <= DIM && rows <= DIM, "unsupported compiler MX mvin rectangle");
+        let base = gpu_dram(rs1);
+        let stride = self.st.ld_stride as usize;
+        for r in 0..rows {
+            copy_row(smem, (row + r) * DIM, gmem, base + r * stride, cols);
+        }
+    }
+
+    fn compiler_mvout(&self, rs1: u64, rs2: u64, smem: &[u8], gmem: &mut [u8]) {
+        let rows = ((rs2 >> 48) & 0xffff) as usize;
+        let cols = ((rs2 >> 32) & 0xffff) as usize;
+        let row = (rs2 & 0xffff_ffff) as usize;
+        assert!(cols <= DIM && rows <= DIM, "unsupported compiler MX mvout rectangle");
+        let base = gpu_dram(rs1);
+        let stride = self.st.st_stride as usize;
+        for r in 0..rows {
+            let src = (row + r) * DIM;
+            let dst = base + r * stride;
+            if src + cols <= smem.len() && dst + cols <= gmem.len() {
+                gmem[dst..dst + cols].copy_from_slice(&smem[src..src + cols]);
+            }
+        }
+    }
