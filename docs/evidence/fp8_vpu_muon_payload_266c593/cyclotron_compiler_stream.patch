+    fn compiler_load_scales(&mut self, rs1: u64, rs2: u64, smem: &mut [u8], gmem: &[u8]) {
+        let pitch = (rs1 >> 40) as usize;
+        let base = gpu_dram(rs1 & 0xffffffffff);
+        let groups = ((rs2 >> 46) & 0x3ffff) as usize;
+        let dest = ((rs2 >> 33) & 0x1fff) as usize;
+        let sel = ((rs2 >> 32) & 1) as usize;
+        let width = (rs2 & 0xffff_ffff) as usize;
+        if dest != 0 {
